{
  "name":"@workspace/fto-law-library-schema",
  "version":"0.0.0",
  "private":true,
  "type":"module",
  "exports":{
    ".":"./src/generated/tokens.tsx",
    "./tokens":"./src/generated/tokens.tsx",
    "./styles.css":"./src/index.css",
    "./library.css":"./src/library.css",
    "./components/*":"./src/components/*.tsx",
    "./lib/*":"./src/lib/*.tsx",
    "./hooks/*":"./src/hooks/*.tsx"
  },
  "imports":{"#components/*":"./src/components/*.tsx","#lib/*":"./src/lib/*.tsx","#hooks/*":"./src/hooks/*.tsx"},
  "scripts":{
    "tokens":"node scripts/build-tokens.mjs",
    "dev":"vite --config vite.config.ts --host 0.0.0.0",
    "prebuild":"node scripts/build-tokens.mjs",
    "build":"vite build --config vite.config.ts",
    "serve":"vite preview --config vite.config.ts --host 0.0.0.0",
    "pretypecheck":"node scripts/build-tokens.mjs",
    "typecheck":"tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies":{"react":">=18","react-dom":">=18"},
  "dependencies":{
    "@tailwindcss/typography":"0.5.19",
    "clsx":"2.1.1",
    "lucide-react":"0.545.0",
    "tailwind-merge":"3.3.1",
    "tw-animate-css":"1.4.0"
  },
  "devDependencies":{
    "@replit/vite-plugin-cartographer":"0.5.1",
    "@replit/vite-plugin-dev-banner":"0.1.1",
    "@replit/vite-plugin-runtime-error-modal":"0.0.6",
    "@tailwindcss/vite":"4.1.14",
    "@types/node":"25.9.9",
    "@types/react":"19.2.0",
    "@types/react-dom":"19.2.0",
    "@vitejs/plugin-react":"5.0.4",
    "react":"19.1.0",
    "react-dom":"19.1.0",
    "tailwindcss":"4.1.14",
    "vite":"7.3.7"
  }
}
