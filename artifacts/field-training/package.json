{
  "name": "@workspace/field-training",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsc --build ../../lib/api-client-react/tsconfig.json",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test:checker": "node --test vite-checker.integration.test.mjs",
    "test:ui-preview": "pnpm run typecheck:tests && BASE_PATH=/field-training-preview/ pnpm run build && TSX_TSCONFIG_PATH=$PWD/tsconfig.test.json pnpm --filter @workspace/scripts exec tsx --test ../artifacts/field-training/src/lib/portal-routing.test.ts ../artifacts/field-training/src/lib/empty-workspace.test.ts ../artifacts/field-training/src/lib/portal-production-build.test.ts"
  },
